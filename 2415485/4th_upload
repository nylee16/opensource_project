import os
import torch
import soundfile as sf
from transformers import WhisperProcessor, WhisperForConditionalGeneration

# 1. processor와 model 불러오기
processor = WhisperProcessor.from_pretrained("SungBeom/whisper-small-ko")
model = WhisperForConditionalGeneration.from_pretrained("./whisper-output/checkpoint-1014")

# 2. 결과를 저장할 리스트
results = []

# 3. wav_16k 폴더 내 모든 wav 파일 변환
wav_folder = "wav_16k"
for filename in os.listdir(wav_folder):
    if filename.endswith(".wav"):
        file_path = os.path.join(wav_folder, filename)
        audio_input, _ = sf.read(file_path)
        input_features = processor(audio_input, sampling_rate=16000, return_tensors="pt").input_features
        with torch.no_grad():
            predicted_ids = model.generate(input_features)
        transcription = processor.batch_decode(predicted_ids, skip_special_tokens=True)[0]
        results.append(f"{filename}: {transcription}")

# 4. 결과를 result.txt 파일에 저장
with open("result.txt", "w", encoding="utf-8") as f:
    for line in results:
        f.write(line + "\n")
