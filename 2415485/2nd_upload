# 3. 라이브러리 임포트
import torch
from datasets import load_dataset, Audio
from transformers import WhisperProcessor, WhisperForConditionalGeneration, Seq2SeqTrainer, Seq2SeqTrainingArguments

# 4. 데이터셋 로드 및 전처리
dataset = load_dataset("bigfish951/whisper-project", data_files="labels.csv", split="train")
dataset = dataset.cast_column("file_path", Audio(sampling_rate=16000))

# train/validation split (9:1 비율)
dataset = dataset.train_test_split(test_size=0.1)
train_dataset = dataset["train"]
eval_dataset = dataset["test"]

# 5. 모델 및 프로세서 로드
model_name = "SungBeom/whisper-small-ko"
processor = WhisperProcessor.from_pretrained(model_name)
model = WhisperForConditionalGeneration.from_pretrained(model_name)

# 6. 입력/출력 포맷팅 함수 정의
def prepare_dataset(batch):
    audio = batch["file_path"]
    inputs = processor(audio["array"], sampling_rate=16000, return_tensors="pt")
    batch["input_features"] = inputs.input_features[0]
    batch["labels"] = processor.tokenizer(batch["transcript"], return_tensors="pt").input_ids[0]
    return batch

# 7. 데이터 전처리 적용
train_dataset = train_dataset.map(prepare_dataset, remove_columns=train_dataset.column_names)
eval_dataset = eval_dataset.map(prepare_dataset, remove_columns=eval_dataset.column_names)

# 8. 훈련 설정
training_args = Seq2SeqTrainingArguments(
    output_dir="./whisper-output",
    per_device_train_batch_size=4,
    per_device_eval_batch_size=4,
    gradient_accumulation_steps=2,
    num_train_epochs=3,
    evaluation_strategy="steps",
    save_strategy="steps",
    logging_steps=100,
    save_steps=500,
    eval_steps=500,
    learning_rate=1e-5,
    warmup_steps=200,
    fp16=torch.cuda.is_available(),
    report_to="none",
)

# 9. Trainer 정의 및 학습
trainer = Seq2SeqTrainer(
    args=training_args,
    model=model,
    train_dataset=train_dataset,
    eval_dataset=eval_dataset,
    tokenizer=processor.feature_extractor,
)

trainer.train()
