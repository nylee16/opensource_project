# 1. 화재 감지 API 호출 (실제 연동)
def check_fire():
    try:
        response = requests.post(
            "http://localhost:5001/predict_path",
            json={"audio_path": "/Users/pit_a_pat_/Desktop/alert.wav"}
        )
        result = response.json()
        print("API 응답:", result)  # 터미널에 결과 출력
        if result.get("situation") == "fire":
            st.session_state.page = "fire"
        else:
            st.session_state.page = "not_fire"
    except Exception as e:
        print("API 호출 오류:", e)  # 터미널에 에러 출력
        st.session_state.page = "not_fire"

